{
  "name": "local-fiction-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:harness": "tsc -p tsconfig.harness.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:test": "cd android && ./gradlew testDebugUnitTest",
    "android:build": "npm run android:sync && cd android && ./gradlew --offline :app:testDebugUnitTest --rerun-tasks assembleDebug",
    "audit:artifacts": "node scripts/audit-artifacts.mjs",
    "verify:all": "npm run typecheck:harness && npm run typecheck && npm run build && npm test && npm run test:e2e && npm run android:build && npm run audit:artifacts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "fflate": "^0.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  }
}
